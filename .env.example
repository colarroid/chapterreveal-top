# The same Supabase project as the main app: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the main app lives, for the "Open app" link in the header.
NEXT_PUBLIC_APP_URL=http://localhost:3020
# Cloudinary, same account and keys as the main app: shared backgrounds (Design).
# The secret is server only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
